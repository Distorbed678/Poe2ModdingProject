# Game data and RE databases (never committed)
/GameFiles/
/GhidraProject/

# Build output
/target/
**/target/

# Downloaded / generated tools (see third_party/README.md and third_party/fetch-tools.sh)
/third_party/*
!/third_party/README.md
!/third_party/fetch-tools.sh

# Datamined / generated outputs (layout and regeneration: dumps/README.md)
/dumps/*
!/dumps/README.md

# Runtime data
/runtime/
/captures/
*.log
*.sqlite
*.sqlite-*
*.db

# Python bytecode
__pycache__/
