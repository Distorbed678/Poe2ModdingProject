{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Distorbed678/Poe2ServerList/servers.schema.json",
  "title": "Poe2 server list",
  "type": "object",
  "required": ["schema", "servers"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "servers": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/server" }
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "required": ["id", "name", "address", "game_version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{1,46})[a-z0-9]$", "description": "Stable key of the entry, 3-48 characters of a-z, 0-9 and -. Never changes." },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "address": { "type": "string", "maxLength": 200, "description": "The address of the server's web API (what a player types under Servers > Add), for example https://play.example.org. It must be reachable from the internet: no localhost, no private network address. Prefer https." },
        "description": { "type": "string", "maxLength": 400 },
        "region": { "type": "string", "maxLength": 24, "description": "A short region name such as EU, NA, Asia, OCE, SA" },
        "game_version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,16}$", "description": "The client version the server runs, for example 0.5.5e. The launcher shows the server's own answer when it is reachable." },
        "tags": { "type": "array", "maxItems": 8, "items": { "type": "string", "pattern": "^[a-z0-9-]{1,24}$" }, "uniqueItems": true },
        "contact": { "type": "string", "maxLength": 120, "description": "A Discord invite, a web page (https link) or an e-mail address, so players can reach the operator" },
        "mods": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
              "version": { "type": "string", "maxLength": 32 },
              "url": { "type": "string", "pattern": "^https://\\S{1,292}$" }
            }
          }
        }
      }
    }
  }
}
